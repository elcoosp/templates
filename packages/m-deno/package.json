{
  "name": "@elcoosp-templates/m-deno",
  "type": "module",
  "version": "1.0.0",
  "description": "Monorepo template with `deno` `turbo`",
  "keywords": [
    "templates",
    "cargo-generate"
  ],
  "author": "elcoosp <elcoosp@gmail.com>",
  "license": "MIT",
  "files": [
    "template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "check": "biome ci .",
    "fix": "biome check --write .",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest run --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@rslib/core": "^1.0.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
