{% if database == "postgres" -%}
# PostgreSQL connection string used by drizzle and better-auth
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{project_name | replace(from="-", to="_")}}
{%- else -%}
# SQLite database file used by drizzle and better-auth
DATABASE_URL=./local.db
{%- endif %}

# Secret used to sign and encrypt sessions (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me

# Base URL of the app
BETTER_AUTH_URL=http://localhost:3000
